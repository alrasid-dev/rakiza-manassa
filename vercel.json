{
  "$schema": "https://vercel.sh",
  "framework": null,
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile --prod=false",
  "buildCommand": "npx --yes pnpm@10.4.1 run vercel-build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
